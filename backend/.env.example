# ============================================================
# Realtime Auction — Backend Environment (EXAMPLE)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- Server ------------------------------------------------
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# ---- Frontend CORS origins ---------------------------------
# Comma-separated list of exact origins
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# ---- Storage -----------------------------------------------
STORAGE=file
DATA_DIR=./data

# ---- Authentication ----------------------------------------
# AUTH_MODE=jwt     → validate Supabase JWTs (production / staging)
# AUTH_MODE=development → static token allowlist (local dev only)
AUTH_MODE=jwt

# Optional legacy JWT secret (HS256). Use its literal value; never base64-decode it.
# Dashboard → Project Settings → Data API → JWT Secret
# JWT_SECRET=your-legacy-jwt-secret-at-least-32-chars

# JWT claims emitted by Supabase Auth
JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
JWT_AUDIENCE=authenticated

# ES256/RS256 signing keys are discovered automatically from SUPABASE_URL.
# Set JWT_JWKS_URL only to override the trusted public-key endpoint.
# JWT_JWKS_URL=https://your-idp/.well-known/jwks.json

# ---- Supabase ----------------------------------------------
# Project URL — not a secret, safe to commit to example files
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key — safe (RLS enforced, rate-limited)
SUPABASE_ANON_KEY=eyJhbGci...

# Service role key — BYPASSES RLS — NEVER expose to frontend
# Dashboard → Project Settings → Data API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Direct Postgres URL — for atomic transactions (persist_sale, etc.)
# Dashboard → Project Settings → Database → Connection string (URI)
# Use port 5432 (direct / session pooler) for long-running Node process
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Development auth (AUTH_MODE=development only) ---------
# DEV_AUTH_TOKENS='{"local-host-token":{"userId":"host","username":"Host"},"local-a-token":{"userId":"user-a"}}'

# ---- Player catalog ----------------------------------------
# Optional CSV or JSON override. Bundled CSV is loaded by default.
# Default catalog is the verified bundled FC24 pool; no path override.

# Optional vendor-neutral structured dialogue endpoint; templates work without it.
# NEGOTIATION_DIALOGUE_URL=https://your-dialogue-service.example/respond
# NEGOTIATION_DIALOGUE_API_KEY=server-only-secret

# Dialogue is server-only. Never set these on Vercel or as NEXT_PUBLIC variables.
NEGOTIATION_DIALOGUE_PROVIDER=template
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: defaults to bundled data/manager-mode/external-players.csv
# MANAGER_MODE_EXTERNAL_PLAYERS_PATH=/absolute/path/to/external-players.csv
# Same-team release/re-sign cooldown; minimum 1 hour, default 24
MANAGER_RELEASE_RESIGN_COOLDOWN_HOURS=24
