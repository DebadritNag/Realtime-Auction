# ============================================================
# Realtime Auction — Backend Environment (EXAMPLE)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- Server ------------------------------------------------
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# ---- Frontend CORS origins ---------------------------------
# Comma-separated list of exact origins
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# ---- Storage -----------------------------------------------
STORAGE=file
DATA_DIR=./data

# ---- Authentication ----------------------------------------
# AUTH_MODE=jwt     → validate Supabase JWTs (production / staging)
# AUTH_MODE=development → static token allowlist (local dev only)
AUTH_MODE=jwt

# Supabase JWT secret (HS256). Required when AUTH_MODE=jwt.
# Dashboard → Project Settings → Data API → JWT Secret
JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars

# JWT claims emitted by Supabase Auth
JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
JWT_AUDIENCE=authenticated

# Alternative: use JWKS for RS256/ES256 (not needed with Supabase HS256)
# JWT_JWKS_URL=https://your-idp/.well-known/jwks.json

# ---- Supabase ----------------------------------------------
# Project URL — not a secret, safe to commit to example files
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key — safe (RLS enforced, rate-limited)
SUPABASE_ANON_KEY=eyJhbGci...

# Service role key — BYPASSES RLS — NEVER expose to frontend
# Dashboard → Project Settings → Data API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Direct Postgres URL — for atomic transactions (persist_sale, etc.)
# Dashboard → Project Settings → Database → Connection string (URI)
# Use port 5432 (direct / session pooler) for long-running Node process
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Development auth (AUTH_MODE=development only) ---------
# DEV_AUTH_TOKENS='{"local-host-token":{"userId":"host","username":"Host"},"local-a-token":{"userId":"user-a"}}'

# ---- Player catalog ----------------------------------------
# Required in production. JSON file with the player catalogue.
# PLAYER_CATALOG_PATH=./players.json
